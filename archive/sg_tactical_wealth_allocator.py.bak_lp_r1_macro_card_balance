      <line x1="{pad_l}" x2="{w-pad_r}" y1="{grid_y2:.1f}" y2="{grid_y2:.1f}" stroke="#E5E7EB" stroke-width="1" stroke-dasharray="2 3"/>
      <line x1="{pad_l}" x2="{w-pad_r}" y1="{pad_t+chart_h:.1f}" y2="{pad_t+chart_h:.1f}" stroke="#CBD5E1" stroke-width="1"/>
