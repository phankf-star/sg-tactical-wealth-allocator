def _flatten_json_dicts(obj):
    rows=[]
    if isinstance(obj,dict):
        rows.append(obj)
        for v in obj.values(): rows.extend(_flatten_json_dicts(v))
    elif isinstance(obj,list):
        for v in obj: rows.extend(_flatten_json_dicts(v))
    return rows

